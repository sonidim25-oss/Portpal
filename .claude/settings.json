{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-tauri-mirror.mjs",
            "timeout": 10,
            "statusMessage": "Checking Tauri command mirroring..."
          }
        ]
      }
    ]
  }
}
